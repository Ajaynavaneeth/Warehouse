# Environment variables the app reads. Never share or commit the real values.

# Required everywhere: the login password (at least 8 characters)
APP_PASSWORD=change-this-to-a-long-password

# Cloud only (Render + Neon):
# Your Neon connection string. If set, the app uses Postgres instead of the local file.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Long random text (32+ characters) that keeps people logged in when the free host sleeps.
# Make one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# SESSION_SECRET=

# Local only (optional): where the SQLite file is kept (default: warehouse.db next to main.py)
# DB_PATH=/path/to/warehouse.db
